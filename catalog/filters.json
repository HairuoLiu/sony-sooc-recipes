{
  "$comment": "SONY SOOC RECIPES — 单一事实来源。所有滤镜配方都登记在这里，APK 由工具从此文件生成，不要手改生成的 Recipes.java。",
  "version": "0.3.0",
  "updated": "2026-09-13",

  "engines": {
    "recipe-lab": {
      "label": "Settings-store engine (Recipe Lab)",
      "what_it_does": "把配方写进相机的持久化设置存储区：创意风格及其饱和度/对比度/锐度、白平衡与微调、曝光补偿、DRO、图片效果，外加一个索尼从未在菜单里公开的色彩矩阵开关。",
      "applies_to": "应用关闭后依然生效，覆盖 P/A/S/M 与录像全部模式。",
      "limits": "只能使用该机型「存得下来」的项目。无色调曲线、无 LUT 文件、无 Log。所有风格都是近似，不是别家色彩科学的复制品。",
      "license": "MIT",
      "upstream": "voxivoid/recipe-lab-sony-pmca",
      "verified_models": ["ILCE-6000 (fw 3.21)", "ILCE-6500", "ILCE-5100", "ILCE-7M2"]
    },
    "film-studio-matrix": {
      "label": "Hardware matrix engine (Film Studio / 胶片工坊)",
      "what_it_does": "改动机内图片处理管线的 3x3 色彩矩阵与 1024 点共同 Gamma 曲线，是真实的逐像素色彩处理，而非仅写设置。",
      "applies_to": "拍照与实验性录像，带 30/50/70/100% 四档强度。",
      "limits": "依赖一个不随仓库分发的基础 APK（bonyback1 的 Ricoh 模组，基于索尼「照片效果+」），且目前只在 a5100 固件 1.10 上实机验证。",
      "license": "PolyForm Noncommercial 1.0.0 (非 OSI 开源，禁止商用)",
      "upstream": "ukiki0718-netizen/sony-a5100-film-studio",
      "verified_models": ["ILCE-5100 (fw 1.10, Android 2.3.7 / API 10)"]
    }
  },

