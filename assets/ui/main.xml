<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: ONE thin floating bar, kept deliberately slim so the live preview keeps
     the frame.
       top bar     ONE line - name · brand · position (v0.93: the parameter summary is
                   hidden by the theme's meta_visibility; the view stays declared)
       bottom bar  RETIRED in v0.92: still declared (MainActivity holds views onto its
                   children) but statically GONE - the editor is the EditorView overlay
     Two things here are toggles rather than fixed, and catalog/ui-theme.json owns them:
     the app title, the CS/PE chip, the key legend and the parameter summary - all off by
     default. Written by tools/patch_ui.py. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

    <!-- panel stays ONE parent view: MainActivity hides the whole overlay with a single
         panel.setVisibility(View.GONE), so both bars below are its CHILDREN and one call
         still hides both. The gap between them is this container showing through. -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical">

        <!-- top bar: a single line. RelativeLayout rather than a row of weights so the
            cluster really is centred on the screen. The left title (when shown) still
            declares a boundary against @+id/head, so a long recipe name gets clipped at its
            own limit instead of sliding over the centred text or off the edge.

             The + on the FIRST mention is not optional. aapt resolves ids in one pass, in
             document order: a bare @id/head here fails with "No resource found that matches
             the given name (at 'layout_toLeftOf' with value '@id/head')" because the bar
             that owns the id is declared further down. That is a build error at the very
             first aapt step, not a warning - tests/test_ui_theme.py enforces the rule
             statically, since aapt cannot be run before the 3 GB toolchain is installed. -->
        <!-- v0.88: this bar is a floating pill, not a slab glued to the top edge. The mock
             it is signed off against insets the topbar and rounds ALL FOUR corners, so
             bar_top does too and the bar carries margins on three sides. Glued to y=0
             with only the bottom two corners rounded it read as a cropped strip, which is
             the "顶部换行/错位" report: the cluster looks like it starts on a second line.

             v0.92: the pill is flattened - 10dp top inset, 8dp radius - because the
             original padding read as an oversized capsule on the 3" screen.
             v0.93: ZERO vertical padding, and every TextView in the bar drops the font's
             reserved leading (includeFontPadding=false, name loses 2dp of line spacing) -
             Noto Sans SC reserves ~1.5em of vertical box per line, which read as a fat
             capsule around 18sp text. The pill's top and bottom edges now sit at the
             text's own line box; only the horizontal padding survives. -->
        <RelativeLayout
            android:id="@+id/topbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bar_top"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/head"
                android:text="@string/app_name"
                android:textSize="9sp"
                android:textColor="#99566473"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="{app_title_visibility}" />

            <!-- the recipe name, with its status and position right behind it.
                 v0.92: @+id/meta joined the cluster (the bottom bar was retired).
                 v0.93: the summary is hidden again by the theme (meta_visibility=gone) -
                 the bar reads name · brand · position only, which also shrinks the pill to
                 a fraction of the width. The view stays declared and written: flip
                 meta_visibility in catalog/ui-theme.json to bring the summary back.
                 includeFontPadding=false + a negative line spacing cut Noto Sans SC's
                 ~1.5em vertical line box down to the glyphs, which is what halves the
                 pill's height. -->
            <LinearLayout
                android:id="@+id/head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="-2dp"
                    android:textColor="#FF16202B"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxEms="16" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:paddingLeft="6dp" android:paddingRight="6dp"
                    android:paddingTop="0dp" android:paddingBottom="0dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:textColor="#CC5C6B7A"
                    android:background="@drawable/chip"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="6dp" android:paddingRight="6dp"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:textColor="#CC44505E"
                    android:singleLine="true"
                    android:ellipsize="start" />

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:textColor="#CC3F4B58"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxEms="18"
                    android:visibility="{meta_visibility}" />
            </LinearLayout>

            <!-- CS / PE chip, off by default (tag_visibility = 'gone' in the theme).
                 Kept declared so MainActivity's findViewById(R.id.tag) still resolves;
                 flip tag_visibility to 'visible' to bring the mode readout back. -->
            <TextView
                android:id="@+id/tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="5dp"
                android:paddingLeft="5dp" android:paddingRight="5dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#CC5C6B7A"
                android:background="@drawable/chip"
                android:singleLine="true"
                android:visibility="{tag_visibility}" />
        </RelativeLayout>

        <!-- everything between the bars: transparent, so the preview shows through -->
        <View
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- bottom bar - RETIRED in v0.92, kept declared. MainActivity still binds and
             writes meta / chips / hints (render() has no idea), so the views must exist or
             every setText is an NPE; statically GONE hides the whole bar in every overlay
             state while keeping it a child of @id/panel (the one-call panel hide still
             works, and the ids stay inside the panel as the resource test requires).
             The summary now lives in @+id/meta inside the top bar's cluster. -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bar_bottom"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/chipscroll"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <{ui_package}.HintBar
                android:id="@+id/hints"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="{legend_visibility}" />
        </LinearLayout>
    </LinearLayout>

    <!-- minimal overlay: recipe pill -->
    <TextView
        android:id="@+id/mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="10dp"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FF16202B"
        android:background="@drawable/pill" />

    <!-- brand browser -->
    <{ui_package}.PickerView
        android:id="@+id/picker"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone" />

    <!-- settings editor: a vertical list of every parameter (label left, value right),
         shown in place of the chip strip while editing. v0.91. -->
    <{ui_package}.EditorView
        android:id="@+id/editor"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- RAW / JPEG prompt -->
    <{ui_package}.PromptView
        android:id="@+id/prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- transient status. 72dp keeps the banner clear of the floating top bar (10dp inset
         plus roughly 30dp of bar), landing it in the upper-middle band the mock shows it in
         rather than on top of the recipe name. -->
    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:paddingLeft="12dp" android:paddingRight="12dp"
        android:paddingTop="5dp" android:paddingBottom="5dp"
        android:textSize="12sp"
        android:textColor="#FF16202B"
        android:background="@drawable/toast_bg"
        android:visibility="gone" />
</FrameLayout>
