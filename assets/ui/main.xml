<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: two frosted bars, kept deliberately thin so the live preview keeps the
     middle of the frame.
       top bar     ONE line - app title | FILM/STYLE + status (centred) | group and position
       bottom bar  what the look actually is: the summary line and the parameter chips
     Two things here are toggles rather than fixed, and catalog/ui-theme.json owns both:
     the app title and the CS/PE chip. The key legend is also declared but hidden. Written
     by tools/patch_ui.py. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

    <!-- panel stays ONE parent view: MainActivity hides the whole overlay with a single
         panel.setVisibility(View.GONE), so both bars below are its CHILDREN and one call
         still hides both. The gap between them is this container showing through. -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical">

        <!-- top bar: a single line. RelativeLayout rather than a row of weights so the
             film/style really is centred on the screen. Both outer items also declare a
             boundary against @+id/head, so a long recipe name gets clipped at its own limit
             instead of sliding over the centred text or off the edge.

             The + on the FIRST mention is not optional. aapt resolves ids in one pass, in
             document order: a bare @id/head here fails with "No resource found that matches
             the given name (at 'layout_toLeftOf' with value '@id/head')" because the bar
             that owns the id is declared further down. That is a build error at the very
             first aapt step, not a warning - tests/test_ui_theme.py enforces the rule
             statically, since aapt cannot be run before the 3 GB toolchain is installed. -->
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bar_top"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/head"
                android:text="@string/app_name"
                android:textSize="9sp"
                android:textColor="#99566473"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="{app_title_visibility}" />

            <!-- the film or style, with its status right behind it -->
            <LinearLayout
                android:id="@+id/head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FF16202B"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxEms="16" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:paddingLeft="6dp" android:paddingRight="6dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:background="@drawable/badge_ok"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:paddingLeft="5dp" android:paddingRight="5dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#CC5C6B7A"
                    android:background="@drawable/chip"
                    android:singleLine="true"
                    android:visibility="{tag_visibility}" />
            </LinearLayout>

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/head"
                android:gravity="right"
                android:textSize="11sp"
                android:textColor="#CC44505E"
                android:singleLine="true"
                android:ellipsize="start" />
        </RelativeLayout>

        <!-- everything between the bars: transparent, so the preview shows through -->
        <View
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- bottom bar -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bar_bottom"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/meta"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#CC3F4B58"
                android:maxLines="2"
                android:ellipsize="end" />

            <HorizontalScrollView
                android:id="@+id/chipscroll"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <{ui_package}.HintBar
                android:id="@+id/hints"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="{legend_visibility}" />
        </LinearLayout>
    </LinearLayout>

    <!-- minimal overlay: recipe pill -->
    <TextView
        android:id="@+id/mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="10dp"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FF16202B"
        android:background="@drawable/pill" />

    <!-- brand browser -->
    <{ui_package}.PickerView
        android:id="@+id/picker"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone" />

    <!-- RAW / JPEG prompt -->
    <{ui_package}.PromptView
        android:id="@+id/prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- transient status -->
    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:paddingLeft="12dp" android:paddingRight="12dp"
        android:paddingTop="5dp" android:paddingBottom="5dp"
        android:textSize="12sp"
        android:textColor="#FF16202B"
        android:background="@drawable/toast_bg"
        android:visibility="gone" />
</FrameLayout>
