        "style": "NEUTRAL",
        "sat": -2,
        "con": -1,
        "sharp": 0,
        "matrix": 0,
        "wb": { "mode": "K", "kelvin": 3200, "ab": 0, "gm": 1 },
        "pe": 0,
        "sub": 0,
        "ev": 1,
        "dro": 3
      }
    },

